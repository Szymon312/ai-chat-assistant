:root {
  --bg: #0b0d12;
  --panel: #151922;
  --panel-soft: #1c2230;
  --panel-alt: #10151d;
  --sidebar: #0e1118;
  --soft-text: #b8c0d1;
  --muted: #7f8ba5;
  --line: rgba(255, 255, 255, 0.08);
  --user: #2a7fff;
  --assistant: #1d2430;
  --text: #edf3ff;
  --accent: #7c9cff;
  --shadow: rgba(0, 0, 0, 0.28);
}

* {
  box-sizing: border-box;
}

html, body, #root {
  margin: 0;
  min-height: 100%;
  height: 100%;
  font-family: 'Inter', sans-serif;
  background: linear-gradient(135deg, #090d15 0%, #0f1729 55%, #111827 100%);
  color: var(--text);
}

body {
  min-height: 100vh;
}

button, input {
  font: inherit;
}

button {
  cursor: pointer;
}

.app-shell {
  display: flex;
  height: 100vh;
  width: 100%;
  background: rgba(7, 10, 16, 0.8);
  backdrop-filter: blur(10px);
}

.sidebar {
  width: 290px;
  background: var(--sidebar);
  border-right: 1px solid var(--line);
  padding: 22px 18px;
  display: flex;
  flex-direction: column;
  gap: 20px;
}

.brand-row {
  display: flex;
  align-items: center;
  gap: 12px;
  padding: 10px 4px 14px;
}

.brand-mark {
  width: 38px;
  height: 38px;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 12px;
  background: linear-gradient(135deg, #7c9cff, #5fd1ff);
  color: #06101d;
  font-weight: 800;
}

.brand-title {
  margin: 0;
  font-size: 1.05rem;
  font-weight: 700;
}

.new-chat-btn {
  appearance: none;
  border: 1px solid var(--line);
  background: rgba(255, 255, 255, 0.02);
  color: var(--text);
  border-radius: 12px;
  padding: 12px 14px;
  text-align: left;
  width: 100%;
  font-weight: 600;
}

.sidebar-section {
  margin-top: 4px;
}

.section-label {
  margin: 0 0 10px;
  font-size: 0.72rem;
  text-transform: uppercase;
  letter-spacing: 0.12em;
  color: var(--muted);
}

.history-list {
  list-style: none;
  padding: 0;
  margin: 0;
  display: flex;
  flex-direction: column;
  gap: 10px;
}

.history-list li {
  padding: 10px 12px;
  border-radius: 10px;
  color: var(--soft-text);
  background: rgba(255, 255, 255, 0.02);
  border: 1px solid transparent;
}

.voice-card {
  margin-top: auto;
  background: linear-gradient(180deg, rgba(124, 156, 255, 0.08), rgba(255, 255, 255, 0.02));
  border: 1px solid rgba(124, 156, 255, 0.18);
  border-radius: 16px;
  padding: 16px;
}

.voice-title {
  margin: 0 0 12px;
  font-size: 0.8rem;
  color: var(--soft-text);
  text-transform: uppercase;
  letter-spacing: 0.12em;
}

.voice-toggle {
  width: 100%;
  border: none;
  border-radius: 12px;
  background: linear-gradient(135deg, #7c9cff, #63d4ff);
  color: #081320;
  font-weight: 700;
  padding: 12px 14px;
  transition: transform 0.2s ease, box-shadow 0.2s ease;
}

.voice-toggle.listening {
  background: linear-gradient(135deg, #ff6b6b, #ff8b7c);
  color: white;
  box-shadow: 0 0 0 4px rgba(255, 107, 107, 0.18);
}

.voice-status {
  display: block;
  margin-top: 10px;
  font-size: 0.82rem;
  color: var(--soft-text);
}

.chat-panel {
  flex: 1;
  display: flex;
  flex-direction: column;
  min-width: 0;
  background: rgba(10, 14, 21, 0.5);
}

.topbar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 18px 24px;
  border-bottom: 1px solid var(--line);
  background: rgba(15, 20, 29, 0.5);
}

.topbar-left {
  display: flex;
  align-items: center;
  gap: 10px;
  font-weight: 600;
}

.status-dot {
  width: 10px;
  height: 10px;
  background: #34d399;
  border-radius: 50%;
  box-shadow: 0 0 8px rgba(52, 211, 153, 0.8);
}

.ghost-btn {
  border: 1px solid var(--line);
  background: rgba(255, 255, 255, 0.02);
  color: var(--text);
  border-radius: 12px;
  padding: 10px 14px;
}

.messages-wrapper {
  flex: 1;
  overflow-y: auto;
  padding: 28px 28px 12px;
  display: flex;
  flex-direction: column;
  gap: 18px;
}

.message-row {
  display: flex;
}

.assistant-row {
  justify-content: flex-start;
}

.user-row {
  justify-content: flex-end;
}

.message-bubble {
  max-width: min(72%, 760px);
  border-radius: 18px;
  padding: 16px 18px;
  line-height: 1.6;
  font-size: 0.98rem;
  word-break: break-word;
}

.message-bubble.assistant {
  background: var(--assistant);
  border: 1px solid var(--line);
  color: var(--text);
}

.message-bubble.user {
  background: linear-gradient(135deg, #2b6ef6, #5f89ff);
  color: white;
  box-shadow: 0 16px 28px rgba(43, 110, 246, 0.25);
}

.suggestions-row {
  display: flex;
  flex-wrap: wrap;
  gap: 10px;
  padding: 0 28px 18px;
}

.suggestions-row button {
  border-radius: 999px;
  background: rgba(255, 255, 255, 0.03);
  color: var(--soft-text);
  border: 1px solid var(--line);
  padding: 10px 14px;
}

.composer {
  display: flex;
  align-items: center;
  gap: 12px;
  padding: 16px 24px 20px;
  border-top: 1px solid var(--line);
  background: rgba(10, 14, 21, 0.85);
}

.icon-btn {
  width: 42px;
  height: 42px;
  border-radius: 12px;
  border: 1px solid var(--line);
  background: rgba(255, 255, 255, 0.02);
  color: var(--text);
}

.composer input {
  flex: 1;
  border: 1px solid var(--line);
  background: rgba(255, 255, 255, 0.02);
  border-radius: 14px;
  color: var(--text);
  padding: 15px 16px;
  font-size: 1rem;
  outline: none;
}

.composer input::placeholder {
  color: var(--muted);
}

.send-btn {
  border: none;
  background: linear-gradient(135deg, #7c9cff, #5fd1ff);
  color: #0b1220;
  font-weight: 700;
  padding: 14px 18px;
  border-radius: 12px;
  min-width: 90px;
}

@media (max-width: 860px) {
  .app-shell {
    flex-direction: column;
  }

  .sidebar {
    width: 100%;
    border-right: none;
    border-bottom: 1px solid var(--line);
  }

  .message-bubble {
    max-width: 85%;
  }

  .composer {
    padding-left: 16px;
    padding-right: 16px;
  }
}
